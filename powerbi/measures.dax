-- Power BI measures for da-learn-14 (tables: fact_covid_daily, fact_country_month, dim_country, dim_date)

New Cases = SUM ( fact_country_month[new_cases] )
New Deaths = SUM ( fact_country_month[new_deaths] )
CFR % = DIVIDE ( [New Deaths], [New Cases] )
Population = SUM ( dim_country[population] )
Deaths per Million = DIVIDE ( [New Deaths], [Population] ) * 1000000
Cases per Million = DIVIDE ( [New Cases], [Population] ) * 1000000

-- Stocks: take the latest month-end value per country, then sum across countries
People Vaccinated (latest) =
    SUMX ( VALUES ( dim_country[country_key] ),
        CALCULATE ( MAX ( fact_country_month[people_vaccinated_eom] ) ) )
Vaccinated % = DIVIDE ( [People Vaccinated (latest)],
    CALCULATE ( [Population], FILTER ( dim_country, CALCULATE ( MAX ( fact_country_month[people_vaccinated_eom] ) ) > 0 ) ) )
Avg Stringency = AVERAGE ( fact_country_month[avg_stringency] )

-- Daily table (sample = India, Apr-May 2021)
Daily New Cases = SUM ( fact_covid_daily[new_cases] )
Daily New Deaths = SUM ( fact_covid_daily[new_deaths] )
Cases 7d Avg =
    AVERAGEX ( DATESINPERIOD ( dim_date[full_date], MAX ( dim_date[full_date] ), -7, DAY ), [Daily New Cases] )
Cumulative Deaths = MAX ( fact_covid_daily[total_deaths] )
